<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AnalysisMode>All</AnalysisMode>
		<AssemblyName>DigitalZenWorks.Database.ToolKit</AssemblyName>
		<AssemblyOriginatorKeyFile>../DatabaseLibraryNet.snk</AssemblyOriginatorKeyFile>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<Authors>James John McGuire</Authors>
		<CLSCompliant>true</CLSCompliant>
		<Company>Digital Zen Works</Company>
		<Copyright>Copyright © 2006 - 2026</Copyright>
		<Description>This client library provides common database functionality.</Description>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<FileVersion>1.4.0.0</FileVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<LangVersion>Latest</LangVersion>
		<NeutralLanguage>en</NeutralLanguage>
		<NoWarn>$(NoWarn);CS8002</NoWarn>
		<PackageId>DigitalZenWorks.Database.ToolKit</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Digital Zen Works;Database</PackageTags>
		<SignAssembly>true</SignAssembly>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<Version>1.4.0</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>1.4.0</PackageValidationBaselineVersion>
		<TargetFrameworks>netstandard2.0;net472;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<!-- Metadata-only fallbacks for transitive references traversed by APICompat.
		PackageDownload does not add dependencies to the published package. -->
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<PackageDownload Include="System.Drawing.Common" Version="[10.0.14]" />
		<PackageDownload Include="System.Security.Principal.Windows" Version="[5.0.0]" />
	</ItemGroup>

	<Target Name="AddApiCompatibilityReferenceFallbacks"
		BeforeTargets="GetReferencesForApiCompatValidatePackage"
		DependsOnTargets="FindReferenceAssembliesForReferences"
		Condition="'$(EnablePackageValidation)'=='true'">
		<ItemGroup>
			<ReferencePathWithRefAssemblies Include="$(NuGetPackageRoot)system.drawing.common/10.0.14/lib/netstandard2.0/System.Drawing.Common.dll" />
			<ReferencePathWithRefAssemblies Include="$(NuGetPackageRoot)system.security.principal.windows/5.0.0/ref/netstandard2.0/System.Security.Principal.Windows.dll" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Common.Logging" Version="3.4.1" />
		<PackageReference Include="Common.Logging.Core" Version="3.4.1" />
		<PackageReference Include="Dapper" Version="2.1.89" />
		<PackageReference Include="DigitalZenWorks.Common.Utilities" Version="1.6.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="MySql.Data" Version="26.10.0" />
		<PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="StyleCop.Analyzers" Version="1.3.177-beta">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Data.OleDb" Version="10.0.14" />
		<PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<!--ItemGroup Condition="'$(Configuration)'=='Debug'">
		<ProjectReference Include="../../UtilitiesNet/UtilitiesNetLibrary/DigitalZenWorks.Common.Utilities.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<PackageReference Include="DigitalZenWorks.Common.Utilities" Version="1.5.78" />
	</ItemGroup-->

	<ItemGroup>
		<InternalsVisibleTo Include="DigitalZenWorks.Database.ToolKit.Tests, " />
		<InternalsVisibleTo Include="MsAccessJetAceTool.Tests, " />
	</ItemGroup>

	<ItemGroup>
		<None Include="../LICENSE">
			<Pack>True</Pack>
			<PackagePath>/</PackagePath>
		</None>
		<None Include="../README.md">
			<Pack>True</Pack>
			<PackagePath>/</PackagePath>
		</None>
		<None Include="../DatabaseLibraryNet.snk" />
		<AdditionalFiles Include="../stylecop.json" />
		<EmbeddedResource Include="Template.accdb">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

</Project>
